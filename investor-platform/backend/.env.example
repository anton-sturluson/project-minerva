# Export in your shell before running migrations or the API.
DATABASE_URL=postgresql+psycopg://minerva:minerva-local-only@127.0.0.1:55432/minerva
INVESTOR_MODE=local
# Test runner creates/drops isolated test_* schemas, never application tables.
TEST_DATABASE_URL=postgresql+psycopg://minerva:minerva-local-only@127.0.0.1:55432/minerva

# Optional fallback for unavailable US histories and complete dated FX.
TIINGO_API_KEY=
